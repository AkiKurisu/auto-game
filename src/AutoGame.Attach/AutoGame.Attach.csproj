<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);AUTOGAME_ATTACH</DefineConstants>
    <AssemblyName>AutoGame.Attach</AssemblyName>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Payload/**/*.cs" />
    <EmbeddedResource Include="Host/AttachProtocol.cs" LogicalName="AutoGame.Payload.AttachProtocol.cs" />
    <EmbeddedResource Include="Host/AutoGameValue.cs" LogicalName="AutoGame.Payload.AutoGameValue.cs" />
    <EmbeddedResource Include="Host/WireProtocol.cs" LogicalName="AutoGame.Payload.WireProtocol.cs" />
    <EmbeddedResource Include="Payload/*.cs" LogicalName="AutoGame.Payload.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Native/AutoGame.Native.dll" LogicalName="AutoGame.Native.dll" Condition="Exists('Native/AutoGame.Native.dll')" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
  </ItemGroup>
</Project>
